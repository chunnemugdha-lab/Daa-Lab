#include <limits.h> 
printf("Node\tDistance\tPath\n");

for (i = 1; i <= n; i++) {    if (i == startnode)
        continue;

    printf("%4d\t", i);

    /* Unreachable vertex */
    if (distance[i] == INFINITY) {
        printf("     INF\tNO PATH\n");
    }
    else {
        printf("%8d\t", distance[i]);

        /* Build path: destination -> source */
        current = i;
        count = 0;

        while (current != -1) {
            path[count++] = current;
            current = parent[current];
        }

        for (j = 0; j < count; j++) {
            printf("%d", path[j]);

            if (j < count - 1)
                printf("<-");
        }

        printf("\n");
    }
						 }
}
int main() { 
	int s, d, w, i, j;
	printf("Enter the number of vertices : ");
	scanf("%d", &V);
	printf("Enter the number of edges : ");
	scanf("%d", &E);
	for(i = 1 ; i <= V; i++) {
		for(j = 1; j <= V; j++) {
			graph[i][i] = 0;
		}
	}
	for(i = 1; i <= E; i++) {
		printf("Enter source : ");
		scanf("%d", &s);
		printf("Enter destination : ");
		scanf("%d", &d);
		printf("Enter weight : ");
		scanf("%d", &w);
		if(s > V || d > V || s <= 0 || d <= 0) {
			printf("Invalid index. Try again.\n");
			i--;
			continue;
		} else {
			graph[s][d] = w;
		}
	}
	printf("Enter the source :");
	scanf("%d", &s);
	dijkstra(graph, V, s); 
	return 0; 
} 
